# =============================================================================
# SAVE — Environment Variables Configuration
# =============================================================================

# 1. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# 2. Supabase Configuration (PostgreSQL, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. LLM Providers (Document Extraction Pipeline)
# The application automatically selects available providers or uses heuristic fallback
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# 4. Stripe Billing (Prepared for monetization phase)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
